# Local Ollama + DeepSeek chatbot configuration.
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# Make sure Ollama is running and the model is pulled:
#   ollama serve
#   ollama pull deepseek-r1:14b

# Where Ollama listens (no /v1 suffix)
OLLAMA_BASE_URL=http://localhost:11434

# The default model (must be installed locally)
OLLAMA_MODEL=deepseek-r1:14b

# Models available in the UI switcher, comma-separated (OLLAMA_MODEL is always included).
# Each model loads only when you select it and send a message.
OLLAMA_MODELS=deepseek-r1:14b,qwen2.5-coder:7b

# --- Optional tuning -------------------------------------------------------
# Keep the model in RAM between requests instead of reloading it (default 30m)
# OLLAMA_KEEP_ALIVE=30m
#
# Max tokens generated per reply. CPU-only machines are slow: 512 is a good default.
# OLLAMA_MAX_TOKENS=512
#
# OLLAMA_TEMPERATURE=0.7
#
# Show DeepSeek-R1's internal reasoning before the final answer (default false)
# OLLAMA_SHOW_THINKING=false
#
# How long the server waits for a reply, in milliseconds (default 10 minutes)
# OLLAMA_TIMEOUT_MS=600000
#
# Override the default system prompt
# OLLAMA_SYSTEM_PROMPT=You are a helpful, concise AI assistant.
#
# Only needed if Ollama sits behind an authenticated proxy/tunnel
# OLLAMA_API_KEY=
